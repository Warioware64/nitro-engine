# SPDX-License-Identifier: CC0-1.0
#
# SPDX-FileContributor: Antonio Niño Díaz, 2023

BLOCKSDS	?= /opt/blocksds/core
BLOCKSDSEXT	?= /opt/blocksds/external

WONDERFUL_TOOLCHAIN	?= /opt/wonderful
ARM_NONE_EABI_PATH	?= $(WONDERFUL_TOOLCHAIN)/toolchain/gcc-arm-none-eabi/bin/

# Source code paths
# -----------------

SOURCEDIRS	:= source
INCLUDEDIRS	:= include source/libdsf source/box3d
GFXDIRS		:=
BINDIRS		:=

# Defines passed to all files
# ---------------------------

ifeq ($(NEA_DEBUG),1)
DEFINES		:= -DNEA_DEBUG -DNEA_BLOCKSDS
else
DEFINES		:= -DNEA_BLOCKSDS
endif

# The Box3D port reads its compile-time configuration from this header, which
# shrinks the desktop defaults to something a 4 MB console can host. Box3D's
# own base.h includes it through BOX3D_USER_CONFIG before anything else.
DEFINES		+= -DBOX3D_USER_CONFIG='"box3d/nea_config.h"'

# Libraries
# ---------

LIBDIRS		:= $(BLOCKSDS)/libs/libnds

# Optional Maxmod spatial sound support
ifeq ($(NEA_MAXMOD),1)
DEFINES		+= -DNEA_MAXMOD
LIBDIRS		+= $(BLOCKSDS)/libs/maxmod
endif

# Build artifacts
# ---------------

ifeq ($(NEA_DEBUG),1)
	NAME		:= NEA_debug
	BOX3DNAME	:= NEA_box3d_debug
	BUILDDIR	:= build_debug
else
	NAME		:= NEA
	BOX3DNAME	:= NEA_box3d
	BUILDDIR	:= build_release
endif
INSTALLNAME	:= nitro-engine-advanced
ARCHIVE		:= lib/lib$(NAME).a

# Box3D ships as its own archive.
#
# It is roughly three times the .text of the rest of the engine (250 KB against
# 74 KB), so libNEA.a stays Nitro Engine Advanced *without* it and a project
# opts in by naming -lNEA_box3d. Archive-member linking already meant an unused
# Box3D cost a ROM nothing; the split makes that structural rather than
# incidental -- no core translation unit can pick up a b3* reference by
# accident, and the `nm --undefined-only` check in the readme proves it.
#
# NEA_NO_BOX3D=1 skips it entirely, for fast core-only iteration.
ARCHIVE_BOX3D	:= lib/lib$(BOX3DNAME).a

# Tools
# -----

PREFIX		:= $(ARM_NONE_EABI_PATH)arm-none-eabi-
CC		:= $(PREFIX)gcc
CXX		:= $(PREFIX)g++
AR		:= $(PREFIX)ar
MKDIR		:= mkdir
RM		:= rm -rf
CP		:= cp
INSTALL	:= install

# Verbose flag
# ------------

ifeq ($(VERBOSE),1)
V		:=
else
V		:= @
endif

# Source files
# ------------

ifneq ($(BINDIRS),)
    SOURCES_BIN	:= $(shell find -L $(BINDIRS) -name "*.bin")
    INCLUDEDIRS	+= $(addprefix $(BUILDDIR)/,$(BINDIRS))
endif
ifneq ($(GFXDIRS),)
    SOURCES_PNG	:= $(shell find -L $(GFXDIRS) -name "*.png")
    INCLUDEDIRS	+= $(addprefix $(BUILDDIR)/,$(GFXDIRS))
endif

SOURCES_S	:= $(shell find -L $(SOURCEDIRS) -name "*.s")
SOURCES_CPP	:= $(shell find -L $(SOURCEDIRS) -name "*.cpp")

# Partition the C sources between the two archives. Everything under
# source/box3d/ is the port itself; source/NEAPhysics3D.c is the NEA-facing
# wrapper, which belongs with it rather than in the core archive -- putting it
# in libNEA.a would give the core an undefined b3* reference, which is exactly
# what the split exists to prevent. It calls back into libNEA.a for
# NEA_ModelSetMatrix, and that cycle is harmless: Makefile.example already links
# inside -Wl,--start-group ... -Wl,--end-group.
SOURCES_C_ALL	:= $(shell find -L $(SOURCEDIRS) -name "*.c")
SOURCES_C_BOX3D	:= $(filter source/box3d/%,$(SOURCES_C_ALL)) \
		   $(filter source/NEAPhysics3D.c,$(SOURCES_C_ALL))
SOURCES_C	:= $(filter-out $(SOURCES_C_BOX3D),$(SOURCES_C_ALL))

# Compiler and linker flags
# -------------------------

DEFINES		+= -D__NDS__ -DARM9

ARCH		:= -march=armv5te -mtune=arm946e-s

WARNFLAGS	:= -Wall -Wno-address-of-packed-member

INCLUDEFLAGS	:= $(foreach path,$(INCLUDEDIRS),-I$(path)) \
		   $(foreach path,$(LIBDIRS),-I$(path)/include)

ASFLAGS		+= -g -x assembler-with-cpp $(DEFINES) $(ARCH) \
		   -mthumb -mthumb-interwork $(INCLUDEFLAGS) \
		   -ffunction-sections -fdata-sections

CFLAGS		+= -g -std=gnu11 $(WARNFLAGS) $(DEFINES) $(ARCH) \
		   -mthumb -mthumb-interwork $(INCLUDEFLAGS) -O2 \
		   -ffunction-sections -fdata-sections \
		   -fomit-frame-pointer

CXXFLAGS	+= -g -std=gnu++14 $(WARNFLAGS) $(DEFINES) $(ARCH) \
		   -mthumb -mthumb-interwork $(INCLUDEFLAGS) -O2 \
		   -ffunction-sections -fdata-sections \
		   -fno-exceptions -fno-rtti \
		   -fomit-frame-pointer

# Intermediate build files
# ------------------------

OBJS_ASSETS	:= $(addsuffix .o,$(addprefix $(BUILDDIR)/,$(SOURCES_BIN))) \
		   $(addsuffix .o,$(addprefix $(BUILDDIR)/,$(SOURCES_PNG)))

HEADERS_ASSETS	:= $(patsubst %.bin,%_bin.h,$(addprefix $(BUILDDIR)/,$(SOURCES_BIN))) \
		   $(patsubst %.png,%.h,$(addprefix $(BUILDDIR)/,$(SOURCES_PNG)))

OBJS_SOURCES	:= $(addsuffix .o,$(addprefix $(BUILDDIR)/,$(SOURCES_S))) \
		   $(addsuffix .o,$(addprefix $(BUILDDIR)/,$(SOURCES_C))) \
		   $(addsuffix .o,$(addprefix $(BUILDDIR)/,$(SOURCES_CPP)))

OBJS		:= $(OBJS_ASSETS) $(OBJS_SOURCES)

OBJS_BOX3D	:= $(addsuffix .o,$(addprefix $(BUILDDIR)/,$(SOURCES_C_BOX3D)))

DEPS		:= $(OBJS:.o=.d) $(OBJS_BOX3D:.o=.d)

# Targets
# -------

.PHONY: all clean install itcm-report

ifeq ($(NEA_NO_BOX3D),1)
all: $(ARCHIVE)
else
all: $(ARCHIVE) $(ARCHIVE_BOX3D)
endif

# Print what each ITCM group costs and what the current selection adds up to.
#
# Sizes come from the built archive rather than a table in the docs, so they
# cannot go stale as the solver changes. Needs $(ARCHIVE_BOX3D) to exist.
#
# The 13,100 baseline is libnds interrupt/cothread code plus NEA's skinning
# (10,112 measured in the physics examples) and b3hot.c's always-on shared math
# (2,988). A game with its own ITCM code should subtract that too.
#
# The group table is expanded by make into "NAME:sym+sym:sel" words before the
# shell runs -- B3_ITCM_SYMS_* and NEA_BOX3D_ITCM_* are make variables, so a
# shell-side $$NAME lookup would find nothing.
#
# The selection logic below has to mirror nea_config.h's alias block exactly,
# because a report that disagrees with the linker is worse than no report at
# all -- `NEA_BOX3D_ITCM_WHEEL=1` really does place both halves, and a table
# that renders them "no" would have a game hunting for 14 KB that is already
# spent. The rules, in the order the header applies them:
#
#   1. A joint alias only forces **on**: `WHEEL=1` sets both halves, `WHEEL=0`
#      is ignored and the halves keep their own values. That mirrors
#      `#if defined(B3_ITCM_WHEEL) && B3_ITCM_WHEEL`.
#   2. The CONTACTS alias forces **either way**, because both its halves
#      default on and turning them off is how a scene affords a joint group.
#      That mirrors the bare `#if defined(B3_ITCM_CONTACTS)`.
#   3. Otherwise the half's own variable wins, then B3_ITCM_DEFAULT_ON.
b3_empty	:=
b3_space	:= $(b3_empty) $(b3_empty)

# Which alias governs a half: its name with the _SOLVE / _WARM suffix removed.
#
# Derived rather than tabulated, and deliberately so -- this block is read
# before B3_ITCM_JOINTS is defined further down, so any table built here with
# $(eval) would be built from an empty list and every alias would silently
# resolve to nothing. A `=` variable expanded at use time has no such ordering
# hazard. CORE and MESH have no suffix and so are their own alias, which lands
# on the same answer their own variable would give.
b3_alias_of	= $(patsubst %_SOLVE,%,$(patsubst %_WARM,%,$(1)))

# The `!` suffix marks a value the caller chose rather than inherited; the shell
# below strips it and renders "(explicit)".
b3_sel_default	= $(if $(filter $(1),$(B3_ITCM_DEFAULT_ON)),1,0)
b3_sel_own	= $(if $(NEA_BOX3D_ITCM_$(1)),$(NEA_BOX3D_ITCM_$(1))!,$(call b3_sel_default,$(1)))
b3_sel		= $(strip \
		    $(if $(filter CONTACTS,$(call b3_alias_of,$(1))),\
		      $(if $(NEA_BOX3D_ITCM_CONTACTS),$(NEA_BOX3D_ITCM_CONTACTS)!,$(call b3_sel_own,$(1))),\
		      $(if $(filter 1,$(NEA_BOX3D_ITCM_$(call b3_alias_of,$(1)))),1!,$(call b3_sel_own,$(1)))))

b3_report_rows	= $(foreach g,$(B3_ITCM_GROUPS),\
		    $(g):$(subst $(b3_space),+,$(B3_ITCM_SYMS_$(g))):$(call b3_sel,$(g)))

itcm-report: $(ARCHIVE_BOX3D)
	@$(PREFIX)nm -S --size-sort -t d $(ARCHIVE_BOX3D) 2>/dev/null \
	   | awk '($$3=="T"||$$3=="t"){print $$4" "$$2+0}' | sort -u > $(BUILDDIR)/.itcm-sizes
	@echo "Box3D ITCM groups            bytes  selected"
	@echo "-------------------------------------------"
	@total=0; \
	for row in $(b3_report_rows); do \
	    g=$${row%%:*}; rest=$${row#*:}; syms=$${rest%%:*}; sel=$${rest##*:}; \
	    case "$$sel" in *!) sel=$${sel%!}; mark=" (explicit)" ;; *) mark="" ;; esac; \
	    bytes=0; \
	    for s in $$(echo "$$syms" | tr '+' ' '); do \
	        n=$$(awk -v s="$$s" '$$1==s {print $$2; exit}' $(BUILDDIR)/.itcm-sizes); \
	        bytes=$$((bytes + $${n:-0})); \
	    done; \
	    if [ "$$sel" = "1" ]; then total=$$((total + bytes)); on="yes$$mark"; \
	    else on="no$$mark"; fi; \
	    printf "  %-24s %7d  %s\n" "$$g" "$$bytes" "$$on"; \
	done; \
	echo "-------------------------------------------"; \
	printf "  %-24s %7d\n" "selected total" "$$total"; \
	printf "  %-24s %7d\n" "baseline + shared math" 13100; \
	printf "  %-24s %7d / 32768\n" "ITCM occupancy" "$$((total + 13100))"; \
	printf "  %-24s %7d\n" "headroom" "$$((32768 - total - 13100))"; \
	if [ $$((total + 13100)) -gt 32768 ]; then \
	    echo; echo "  OVER BUDGET -- the ROM link will fail with"; \
	    echo "  'section .itcm will not fit in region itcm'"; \
	fi
	@$(RM) $(BUILDDIR)/.itcm-sizes

$(ARCHIVE): $(OBJS)
	@echo "  AR      $@"
	@$(MKDIR) -p $(@D)
	$(V)$(AR) rcs $@ $(OBJS)

$(ARCHIVE_BOX3D): $(OBJS_BOX3D)
	@echo "  AR      $@"
	@$(MKDIR) -p $(@D)
	$(V)$(AR) rcs $@ $(OBJS_BOX3D)

install: all
	@echo "  INSTALL $(BLOCKSDSEXT)/$(INSTALLNAME)/"
	$(V)$(RM) $(BLOCKSDSEXT)/$(INSTALLNAME)/
	$(V)$(INSTALL) -d $(BLOCKSDSEXT)/$(INSTALLNAME)/ \
	                  $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/img2ds \
	                  $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/md5_to_dsma \
	                  $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/obj2dl \
	                  $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/animmat_editor \
	                  $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/npe_editor \
	                  $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/cell_editor \
					  $(BLOCKSDSEXT)/$(INSTALLNAME)/blender_addon
	$(V)$(CP) -r include lib $(BLOCKSDSEXT)/$(INSTALLNAME)/
	$(V)$(CP) -r blender_addon/*.py $(BLOCKSDSEXT)/$(INSTALLNAME)/blender_addon
	$(V)$(CP) -r tools/img2ds/*.py $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/img2ds
	$(V)$(CP) -r tools/md5_to_dsma/*.py $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/md5_to_dsma
	$(V)$(CP) -r tools/obj2dl/*.py $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/obj2dl
	$(V)$(CP) -r tools/animmat_editor/*.py $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/animmat_editor
	$(V)$(CP) -r tools/npe_editor/*.py $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/npe_editor
	$(V)$(CP) -r tools/cell_editor/*.py $(BLOCKSDSEXT)/$(INSTALLNAME)/tools/cell_editor
	$(V)$(CP) -r licenses $(BLOCKSDSEXT)/$(INSTALLNAME)/

clean:
	@echo "  CLEAN"
	$(V)$(RM) $(ARCHIVE) $(ARCHIVE_BOX3D) build_debug build_release

# Rules
# -----

$(BUILDDIR)/%.s.o : %.s
	@echo "  AS      $<"
	@$(MKDIR) -p $(@D)
	$(V)$(CC) $(ASFLAGS) -MMD -MP -c -o $@ $<

$(BUILDDIR)/%.c.o : %.c
	@echo "  CC      $<"
	@$(MKDIR) -p $(@D)
	$(V)$(CC) $(CFLAGS) -MMD -MP -c -o $@ $<

# The Box3D archive builds in ARM mode rather than Thumb.
#
# Fixed-point arithmetic rests on 32x32->64 multiplies. In ARM mode each one
# is a single SMULL/SMLAL; Thumb-1 on ARMv5TE has no such instruction, so GCC
# emits a call to __aeabi_lmul instead -- 16 instructions and a branch in
# place of 7 inline ones, on the most frequent operation in the engine.
#
# This inverts the usual size argument too: the ARM build of b3fixed.c is
# smaller than the Thumb one (312 vs 360 bytes), because the call setup costs
# more than the wider encoding saves.
#
# Stated against OBJS_BOX3D rather than a source/box3d/%.c pattern rule, which
# is what it used to be. That pattern silently excluded source/NEAPhysics3D.c,
# even though SOURCES_C_BOX3D above deliberately groups it with the port and it
# ships in the same archive -- so the NEA-facing wrapper was built Thumb and
# paid __aeabi_lmul 18 times in NEA_Phys3DSyncModels, which runs once per moving
# body per frame, and 16 times in NEA_Phys3DBodyAddBoneShapeI. Deriving the flag
# from the same variable that defines the archive means the two cannot drift
# apart again.
#
# -marm lands after the -mthumb inside CFLAGS and GCC takes the last of the
# pair. -mthumb-interwork is on, so the calls back into libNEA.a still work.
#
# -Os rides along for the same reason, and by the same last-flag-wins rule
# against the -O2 in CFLAGS. The archive is instruction-cache bound, not
# instruction-count bound: the ARM9 has 8 KiB of icache, and at -O2 the inlining
# of the fixed-point layer grows b3SolveWheelJoint to 29 KiB -- 3.6x a cache
# that has to hold the contact solver and every other joint type at the same
# time. The sub-step loop calls it eight times per joint per frame, so each of
# those calls streams its whole body back from main RAM.
#
# -Os takes b3SolveWheelJoint to 11 KiB and b3WarmStartWheelJoint from 8.9 to
# 2.8, and it does not undo the reason -marm is here: SMULL is still emitted.
# The trade is a few more executed instructions against far fewer fetch stalls,
# which is the right side of the trade on this CPU. Emulators that do not model
# the icache will disagree; hardware is the arbiter.
$(OBJS_BOX3D): CFLAGS += -marm -Os

# source/box3d/b3hot.c places its handful of shared leaf helpers in ITCM, the
# ARM9's 32 KB zero-wait-state instruction memory. About 2.9 KB, against the
# ~22 KB that libnds and NEA's skinning code leave free -- see the file's own
# comment for what qualifies and why.
#
# NEA_BOX3D_NO_ITCM=1 keeps them in main RAM, for a game that has already
# committed its ITCM elsewhere. The deduplication is unaffected either way;
# only the section changes. Overcommitting ITCM is a link error, not a silent
# failure, so a game that needs this flag finds out at build time.
ifeq ($(NEA_BOX3D_NO_ITCM),1)
$(OBJS_BOX3D): CFLAGS += -DB3_NO_ITCM
endif

# Per-step cost attribution. Three levels, passed through the same way the ITCM
# switches are, with the defaults and the caveats in include/box3d/nea_config.h.
#
#   make -f Makefile.blocksds install NEA_BOX3D_PROFILE=1
#   make -f Makefile.blocksds install NEA_BOX3D_PROFILE=1 NEA_BOX3D_PROFILE_SUBSTEP=1
#
# SUBSTEP and NARROW are meaningless without PROFILE, since they ride on the
# same probe -- so asking for either turns PROFILE on rather than silently
# producing a profile of nothing.
B3_PROFILE_LEVELS := PROFILE PROFILE_SUBSTEP PROFILE_NARROW

ifneq ($(NEA_BOX3D_PROFILE_SUBSTEP)$(NEA_BOX3D_PROFILE_NARROW),)
NEA_BOX3D_PROFILE := 1
endif

B3_PROFILE_DEFINES := $(foreach l,$(B3_PROFILE_LEVELS),\
		        $(if $(NEA_BOX3D_$(l)),-DB3_NEA_$(l)=$(NEA_BOX3D_$(l))))

$(OBJS_BOX3D): CFLAGS += $(B3_PROFILE_DEFINES)

# Per-group ITCM selection for the solver itself, which is far too large to
# place unconditionally. Each group is a slice of per-sub-step code with a
# published byte cost; the defaults and the reasoning live in
# include/box3d/nea_config.h, and `make -f Makefile.blocksds itcm-report`
# prints the live costs from the built archive.
#
#   make -f Makefile.blocksds install NEA_BOX3D_ITCM_CONTACTS=0 NEA_BOX3D_ITCM_WHEEL=1
#
# The value is passed through rather than tested against 1, so that both
# directions work: turning a default-off group on, and turning the default-on
# CONTACTS group off to afford a large joint group. A group the caller does not
# mention gets no -D at all and keeps nea_config.h's default.
# Solve and warm start are separate groups per joint type, because their fetch
# volumes differ by roughly 8x and the solve halves are what does not fit. See
# the "Why solve and warm start are separate groups" comment in nea_config.h for
# the arithmetic that forced the split.
#
# The whole-group names are still accepted and set both halves -- nea_config.h
# has the aliases -- so an existing NEA_BOX3D_ITCM_WHEEL=1 build line is
# unchanged in meaning. They are listed after the halves so that the report
# renders the halves and the aliases stay purely a compatibility path.
B3_ITCM_JOINTS	:= WHEEL PRISMATIC REVOLUTE SPHERICAL DISTANCE MOTOR WELD PARALLEL

B3_ITCM_GROUPS	:= $(foreach j,$(B3_ITCM_JOINTS),$(j)_SOLVE $(j)_WARM) \
		   CONTACTS_SOLVE CONTACTS_WARM CORE MESH

B3_ITCM_ALIASES	:= $(B3_ITCM_JOINTS) CONTACTS

B3_ITCM_DEFINES	:= $(foreach g,$(B3_ITCM_GROUPS) $(B3_ITCM_ALIASES),\
		     $(if $(NEA_BOX3D_ITCM_$(g)),-DB3_ITCM_$(g)=$(NEA_BOX3D_ITCM_$(g))))

$(OBJS_BOX3D): CFLAGS += $(B3_ITCM_DEFINES)

# -------------------------------------------------------------------------
# Rebuild when the configuration changes, not only when the sources do
# -------------------------------------------------------------------------
#
# Make compares timestamps of files. None of the switches above is a file, so
# changing one and rebuilding without `clean` leaves every object exactly as it
# was -- the .c is older than the .o, so nothing recompiles, and the archive
# keeps whatever placement the *previous* flags asked for.
#
# That is not a cosmetic problem. Going from NEA_BOX3D_ITCM_WHEEL=1 to
# NEA_BOX3D_ITCM_WHEEL_SOLVE=1 without a clean leaves b3WarmStartWheelJoint in
# .itcm from the earlier build, and the link fails with "section .itcm will not
# fit" against a configuration whose own report says it has 1,104 bytes spare.
# The failure at least announces itself; the reverse case does not. Turning a
# group *off* and rebuilding leaves it on, so an A/B of two ITCM configurations
# silently measures the same ROM twice -- and the whole reason these switches
# exist is to be measured against each other.
#
# So the configuration is written to a file and the objects depend on it. The
# stamp is rewritten only when the signature actually changes, so an unchanged
# configuration still does nothing.
B3_CONFIG_SIG	:= $(strip $(B3_ITCM_DEFINES) $(B3_PROFILE_DEFINES) NO_ITCM=$(NEA_BOX3D_NO_ITCM))
B3_CONFIG_STAMP	:= $(BUILDDIR)/.box3d-config

$(shell mkdir -p $(BUILDDIR); \
	[ "$$(cat $(B3_CONFIG_STAMP) 2>/dev/null)" = "$(B3_CONFIG_SIG)" ] \
	  || printf '%s' "$(B3_CONFIG_SIG)" > $(B3_CONFIG_STAMP))

$(OBJS_BOX3D): $(B3_CONFIG_STAMP)

# What each group contains, for `make itcm-report`. Kept next to the group list
# so that adding a group means editing one place.
B3_ITCM_SYMS_WHEEL_SOLVE	:= b3SolveWheelJoint
B3_ITCM_SYMS_WHEEL_WARM		:= b3WarmStartWheelJoint
B3_ITCM_SYMS_PRISMATIC_SOLVE	:= b3SolvePrismaticJoint
B3_ITCM_SYMS_PRISMATIC_WARM	:= b3WarmStartPrismaticJoint
B3_ITCM_SYMS_REVOLUTE_SOLVE	:= b3SolveRevoluteJoint
B3_ITCM_SYMS_REVOLUTE_WARM	:= b3WarmStartRevoluteJoint
B3_ITCM_SYMS_SPHERICAL_SOLVE	:= b3SolveSphericalJoint
B3_ITCM_SYMS_SPHERICAL_WARM	:= b3WarmStartSphericalJoint
B3_ITCM_SYMS_DISTANCE_SOLVE	:= b3SolveDistanceJoint
B3_ITCM_SYMS_DISTANCE_WARM	:= b3WarmStartDistanceJoint
B3_ITCM_SYMS_MOTOR_SOLVE	:= b3SolveMotorJoint
B3_ITCM_SYMS_MOTOR_WARM		:= b3WarmStartMotorJoint
B3_ITCM_SYMS_WELD_SOLVE		:= b3SolveWeldJoint
B3_ITCM_SYMS_WELD_WARM		:= b3WarmStartWeldJoint
B3_ITCM_SYMS_PARALLEL_SOLVE	:= b3SolveParallelJoint
B3_ITCM_SYMS_PARALLEL_WARM	:= b3WarmStartParallelJoint
B3_ITCM_SYMS_CONTACTS_SOLVE	:= b3SolveContacts
B3_ITCM_SYMS_CONTACTS_WARM	:= b3WarmStartContacts
B3_ITCM_SYMS_MOTOR	:= b3SolveMotorJoint b3WarmStartMotorJoint
B3_ITCM_SYMS_WELD	:= b3SolveWeldJoint b3WarmStartWeldJoint
B3_ITCM_SYMS_PARALLEL	:= b3SolveParallelJoint b3WarmStartParallelJoint
B3_ITCM_SYMS_CONTACTS	:= b3SolveContacts b3WarmStartContacts
B3_ITCM_SYMS_CORE	:= b3Solve
B3_ITCM_SYMS_MESH	:= b3ComputeMeshManifolds

# Groups on by default, mirroring the #ifndef defaults in nea_config.h. Only
# used to render the report; the compiler still takes its truth from the header.
B3_ITCM_DEFAULT_ON	:= CONTACTS_SOLVE CONTACTS_WARM

$(BUILDDIR)/%.arm.c.o : %.arm.c
	@echo "  CC      $<"
	@$(MKDIR) -p $(@D)
	$(V)$(CC) $(CFLAGS) -MMD -MP -marm -mlong-calls -c -o $@ $<

$(BUILDDIR)/%.cpp.o : %.cpp
	@echo "  CXX     $<"
	@$(MKDIR) -p $(@D)
	$(V)$(CXX) $(CXXFLAGS) -MMD -MP -c -o $@ $<

$(BUILDDIR)/%.arm.cpp.o : %.arm.cpp
	@echo "  CXX     $<"
	@$(MKDIR) -p $(@D)
	$(V)$(CXX) $(CXXFLAGS) -MMD -MP -marm -mlong-calls -c -o $@ $<

$(BUILDDIR)/%.bin.o $(BUILDDIR)/%_bin.h : %.bin
	@echo "  BIN2C   $<"
	@$(MKDIR) -p $(@D)
	$(V)$(BLOCKSDS)/tools/bin2c/bin2c $< $(@D)
	$(V)$(CC) $(CFLAGS) -MMD -MP -c -o $(BUILDDIR)/$*.bin.o $(BUILDDIR)/$*_bin.c

$(BUILDDIR)/%.png.o $(BUILDDIR)/%.h : %.png %.grit
	@echo "  GRIT    $<"
	@$(MKDIR) -p $(@D)
	$(V)$(BLOCKSDS)/tools/grit/grit $< -ftc -W1 -o$(BUILDDIR)/$*
	$(V)$(CC) $(CFLAGS) -MMD -MP -c -o $(BUILDDIR)/$*.png.o $(BUILDDIR)/$*.c
	$(V)touch $(BUILDDIR)/$*.png.o $(BUILDDIR)/$*.h

# All assets must be built before the source code
# -----------------------------------------------

$(SOURCES_S) $(SOURCES_C) $(SOURCES_CPP): $(HEADERS_ASSETS)

# Include dependency files if they exist
# --------------------------------------

-include $(DEPS)
